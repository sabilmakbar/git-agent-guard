#!/bin/sh
# Record this repository's AI-attribution decision, once.
#
#   gag-attribution include   # commits carry a Co-Authored-By trailer, PRs a footer
#   gag-attribution exclude   # commits carry no trailer
#   gag-attribution default   # defer to whatever the global setting says
#
# Run from inside the repository. `include` writes the repo's
# .claude/settings.local.json, which overrides the global setting for this
# repository only; the local settings file is the per-machine, untracked one,
# so nothing about the decision enters the repo's history.

set -u

# Pinned deliberately, and deliberately generic. Left to its own default,
# Claude Code names the model in the trailer ("Claude Sonnet 5", "Claude Haiku
# 4.5", observed), so a repo accumulates a different co-author identity per
# model and per model release. One stable identity keeps the history greppable.
TRAILER='Co-Authored-By: Claude <noreply@anthropic.com>'
PR_FOOTER='Generated with [Claude Code](https://claude.com/claude-code)'
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/git-agent-guard"
decisions="$cfg/attribution-decisions"

choice="${1:-}"
case "$choice" in
    include|exclude|default) ;;
    *) echo "usage: gag-attribution include|exclude|default" >&2; exit 2 ;;
esac

git rev-parse --git-dir >/dev/null 2>&1 || { echo "not inside a git repository" >&2; exit 2; }
root=$(git rev-parse --show-toplevel)

# Repo identity: the remote URL when there is one, so the decision follows the
# project across clones; the path otherwise.
key=$(git remote get-url origin 2>/dev/null) || key=""
[ -n "$key" ] || key="$root"

settings="$root/.claude/settings.local.json"

# A repository can ship .claude, or the settings file inside it, as a symlink
# pointing anywhere the user can write. Following it would let a cloned repo
# aim this write at a file outside itself, so refuse before recording anything.
if [ "$choice" = include ]; then
    for p in "$root/.claude" "$settings"; do
        if [ -L "$p" ]; then
            echo "refusing: $p is a symlink; writing through it could modify a file outside this repository. Nothing recorded." >&2
            exit 1
        fi
    done
fi

mkdir -p "$cfg"
touch "$decisions"
# Replace any previous decision for this key rather than accumulating.
tmp="$decisions.tmp.$$"
grep -v "^$(printf '%s' "$key" | sed 's/[[\.*^$/]/\\&/g') " "$decisions" > "$tmp" 2>/dev/null || :
printf '%s %s\n' "$key" "$choice" >> "$tmp"
mv "$tmp" "$decisions"
echo "recorded: $key -> $choice"

[ "$choice" = include ] || { echo "No repo-local settings written (global setting applies)."; exit 0; }

# include: override the global setting for this repository only. The new
# content goes to a fresh mktemp file (never a predictable name a symlink could
# sit at) and is renamed into place.
mkdir -p "$root/.claude" || exit 1
tmp=$(mktemp "$root/.claude/settings.local.json.XXXXXX") || { echo "cannot create a temp file in $root/.claude" >&2; exit 1; }
if [ -f "$settings" ]; then
    command -v jq >/dev/null 2>&1 || { rm -f "$tmp"; echo "jq needed to merge into existing $settings" >&2; exit 1; }
    jq --arg t "$TRAILER" --arg p "$PR_FOOTER" '.attribution.commit = $t | .attribution.pr = $p' "$settings" > "$tmp" \
      || { rm -f "$tmp"; echo "could not merge into $settings (is it valid JSON?)" >&2; exit 1; }
else
    printf '{\n  "attribution": {\n    "commit": "%s",\n    "pr": "%s"\n  }\n}\n' "$TRAILER" "$PR_FOOTER" > "$tmp"
fi
mv "$tmp" "$settings" || { rm -f "$tmp"; exit 1; }
echo "wrote $settings"

# The local settings file is meant to stay out of history. Say so rather than
# editing .gitignore, which is a tracked file and the user's to change.
if ! git check-ignore -q .claude/settings.local.json 2>/dev/null; then
    echo "NOTE: .claude/settings.local.json is not gitignored here. Add this line to .gitignore so it stays local:"
    echo "  .claude/settings.local.json"
fi
